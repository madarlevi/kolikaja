#
# Optional settings for docker-compose.yml. Copy this file to ".env" in the repository root
# only if you want to change something; `docker compose up` works without it.
# It holds NO secrets: the database password and the JWT key are generated on the first
# start into the "db-secrets" and "app-secrets" volumes (docs/DECISIONS.md T-46). Never put
# secrets here.

# Host address and port of the API. The default 127.0.0.1 accepts connections from this
# computer only (also from the Android emulator through 10.0.2.2). Set HTTP_BIND=0.0.0.0 to
# test with a phone on the same network; use a TLS reverse proxy for anything public.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# The public address of this instance (used as JWT issuer/audience). Use https:// behind
# a TLS reverse proxy; HSTS is sent only for https addresses.
PUBLIC_BASE_URL=http://localhost:8080

# Instance name shown in the apps.
INSTANCE_NAME=KoliKaja

# Who may create dormitories: global_admins (default) or all_users.
DORMITORY_CREATION=global_admins

# Where users of this instance can get the source code (AGPL-3.0). Change it if you run
# a modified version.
SOURCE_CODE_URL=https://github.com/madarlevi/kolikaja

# Operator-provided legal links and contact, shown in the apps (empty = not configured).
# TODO(operator): fill these in before opening the instance to other people.
PRIVACY_POLICY_URL=
TERMS_URL=
TRADEMARKS_URL=
OPERATOR_CONTACT=

# Comma-separated CIDR ranges of reverse proxies whose X-Forwarded-For is trusted.
# Leave empty when clients connect to the API directly.
TRUSTED_PROXIES=

# debug, info, warn or error
LOG_LEVEL=info

# production (JSON logs) or development (text logs)
KOLIKAJA_ENV=production
