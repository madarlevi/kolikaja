root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

[*.{kt,kts,swift}]
indent_size = 4

[*.sql]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
