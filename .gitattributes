# Normalize text files to LF in the repository and in the working tree.
# Reason: the maintainer works on Windows with core.autocrlf=true; shell scripts,
# SQL migrations and Dockerfiles must keep LF endings to work inside Linux containers.

* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Generated files: collapse in diffs.
apps/web/src/api/generated/** linguist-generated=true
docs/api/authz-matrix.md linguist-generated=true

# Semgrep rule tests are deliberately vulnerable code; keep them out of language statistics.
.semgrep/** linguist-vendored=true
